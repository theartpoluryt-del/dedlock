LICENSE_PEPPER=generate-at-least-32-random-bytes
IP_HASH_PEPPER=generate-a-different-at-least-32-random-bytes
AXIOM_SIGNING_PRIVATE_KEY_B64=base64-of-pkcs8-p256-private-key

# Telegram sales bot (Supabase Edge Function: axiom-bot)
TELEGRAM_BOT_TOKEN=bot-token-from-BotFather
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=generate-32-to-64-random-url-safe-characters
# Separate private operator bot. Only SUPPORT_ADMIN_IDS can use it.
SUPPORT_BOT_TOKEN=support-bot-token-from-BotFather
SUPPORT_WEBHOOK_SECRET=generate-a-different-32-to-64-random-url-safe-string
SUPPORT_ADMIN_IDS=123456789
BOT_KEY_ENCRYPTION_KEY=base64-of-exactly-32-random-bytes
ACTIVATION_CODE_PEPPER=generate-a-different-at-least-32-random-bytes
DISPLAY_TIME_ZONE=Asia/Yekaterinburg
# Public direct-download URL opened by the bot's /download button.
AXIOM_DOWNLOAD_URL=https://github.com/theartpoluryt-del/dedlock/raw/refs/heads/main/Dll6/x64/Release/AxiomLauncher.exe

# Purchases are fulfilled by one-time codes from FunPay auto-delivery.
# Keep in-bot payments disabled; purchase URLs live in axiom_plans.
PAYMENT_PROVIDER=disabled
